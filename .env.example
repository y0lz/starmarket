# ⚠️ ВАЖНО: Никогда не коммитьте этот файл с реальными значениями!
# Скопируйте этот файл в .env и заполните своими данными

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Mini App URL (Vercel deployment)
MINI_APP_URL=https://your-app.vercel.app

# Optional: Webhook URL for production
WEBHOOK_URL=https://your-app.vercel.app/api/webhook
